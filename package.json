{
  "name": "dnd-5e-char-manager",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "live-server --port=4173",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "lint": "npm run lint:eslint; npm run lint:html; npm run lint:custom",
    "lint:eslint": "eslint main.html tests scripts eslint.config.js",
    "lint:html": "html-validate main.html",
    "lint:custom": "node scripts/lint-custom.mjs main.html",
    "check": "npm run lint:html && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "eslint": "^10.8.1",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.11.0",
    "html-validate": "^11.6.2",
    "live-server": "^1.2.2"
  }
}
